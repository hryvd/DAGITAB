{
  "name": "dagitab",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node server/dev.mjs",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "dev:client": "vite --host 0.0.0.0",
    "api": "node --watch server/index.mjs",
    "start": "node server/index.mjs",
    "admin:create": "node server/admin.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser-smoke.mjs",
    "admin:demo": "node server/admin-demo.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.2.8",
    "@fontsource/space-grotesk": "5.2.10",
    "lucide-react": "0.468.0",
    "postgres": "4.1.1",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "playwright-core": "1.65.1",
    "prettier": "3.6.2",
    "vite": "7.2.2"
  }
}
